#!/usr/bin/env bash

# -e: err exit: エラーが発生したらスクリプトを終了
# -u: nounset: 未定義の変数を使用したらエラー
# -o pipefail: option pipefail: パイプライン全体の終了コードが、途中で失敗したコマンドの終了コードとなる。デフォルトは最後のコマンドの終了コード
set -euo pipefail

# ------------------ Metadata ------------------

SCHEMA_VERSION="0.1.0"
VENDOR="tipsy"
VERSION="0.0.1"
SHORT_DESCRIPTION="Docker network map"
URL=""

# Docker info で表示されるメタデータ
print_metadata() {
    cat <<EOF
{"SchemaVersion":"${SCHEMA_VERSION}","Vendor":"${VENDOR}","Version":"${VERSION}","ShortDescription":"${SHORT_DESCRIPTION}","URL":"${URL}"}
EOF
}

# Docker 登録用
# ./script.sh start をすると $1 = start となる
# ${1:-}: -: デフォルト値に空文字列を指定 -u指定のため未指定時でもちゃんと動くように
if [[ "${1:-}" == "docker-cli-plugin-metadata" ]]; then
  print_metadata
	# 成功終了
  exit 0
fi

# ------------------ Prepare ------------------

# Docker が付ける先頭のプラグイン名を除去
if [[ "${1:-}" == "netmap" ]]; then
  shift
fi

# ------------------ Options ------------------
# help
show_usage() {
  cat <<EOF
${SHORT_DESCRIPTION}
Usage:  docker netmap [OPTIONS]
Options:
  -h, --help       Print this help message
  -V, --version    Print plugin version

Examples:
  docker netmap
  docker netmap --help
EOF
}

show_version() {
  printf 'docker-netmap %s (%s)\n' "${VERSION}" "${VENDOR}"
}

# オプション解析
# $#: 渡された引数の数
# -gt: >
# = 引数が0より大きい場合
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_usage
      exit 0
      ;;
    -V|--version)
      show_version
      exit 0
      ;;
    --)
			# shift: 引数を1つ消費する, $1が消費され$#が1減る
      shift
      break
      ;;
    -*)
			# >&2: 標準エラー出力にリダイレクト
      printf 'docker-netmap: unknown option: %s\n' "$1" >&2
      printf 'try `docker netmap --help` for more information.\n' >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
  shift
done

# ------------------ Subcommands ------------------

# サブコマンドがある場合
# 現在はサブコマンド未実装
if [[ $# -gt 0 ]]; then
	printf 'docker-netmap: unknown command: %s\n' "$1" >&2
	printf 'try `docker netmap --help` for more information.\n' >&2
	exit 1
fi

# ------------------ Main ------------------

# コンテナ情報取得
# 引数: 
# $1: コンテナ名配列参照
# $2: ポート連想配列参照(key: container)
# $3: ステータス連想配列参照(key: container)
load_docker_ps() {
	# -n: nameref: 変数名の参照
	# $1, $2, $3: 引数名を参照して、そこに値を代入
	# -> returnが無いためこれで値を返す
	local -n ref_container_names="$1"
	local -n ref_container_ports="$2"
	local -n ref_container_status="$3"

	# 標準入力から1行ずつ、タブで分割してname, ports, statusに代入
	# read: 標準入力から1行読み込み変数へ代入, -r: raw: そのまま読み込む \ 等のエスケープを無視
	# IFS: Input Field Separator: readがどこで分割するかを指定, $'\t': タブ
	while IFS=$'\x1f' read -r name ports status; do
		# -z: 文字列が空
		# -> 空行の場合はスキップ
		# "$name" のように""で囲むことで、名前にスペースが含まれていてもに扱える
		[[ -z "$name" ]] && continue

		# (): 配列, +=("$net"): "$net"を要素とする配列を追加する
		ref_container_names+=("$name")
		ref_container_ports["$name"]="$ports"
		ref_container_status["$name"]="$status"

	# <(): プロセス置換: プロセスの出力をファイルであるかのように置き換える
	# < <(): 入力リダイレクトで、<()の中身を標準入力として読み込む、一般的なパターン
	done < <(docker ps -a --format '{{.Names}}{{"\x1f"}}{{.Ports}}{{"\x1f"}}{{.Status}}')
}

# コンテナ詳細情報取得
# 引数: 
# $1: コンテナ名配列参照(only read)
# $2: dns連想配列参照(key: network|container)
# $3: コンテナ連想配列参照(key: network, value: コンテナ名群(/t区切り))
load_docker_inspect() {
	local -n ref_containers="$1"
	local -n ref_container_dns="$2"
	local -n ref_network_containers="$3"

	# コンテナが無い場合は終了
	# containers[@]: 配列の全要素を参照
	# #: 長さ
	# ${#containers[@]}: containers配列の要素数を取得
	[[ ${#ref_containers[@]} -eq 0 ]] && return 0

	# コンテナ詳細情報取得
  local name net dns_val
  while IFS=$'\t' read -r name net dns_val; do
		# コンテナ名もしくはネットワーク名が空の場合はスキップ
    [[ -z "$name" || -z "$net" ]] && continue
		
		# #/: 先頭の/を削除: inspectではコンテナ名が/で始まる
    name="${name#/}"
		# dns追加
    ref_container_dns["${net}|${name}"]="${dns_val}"

		# ネットワークに所属するコンテナ追加 タブ区切りで積む
		if [[ -z "${ref_network_containers[$net]:-}" ]]; then
			ref_network_containers["$net"]="${name}"
		else
			ref_network_containers["$net"]+=$'\t'"${name}"
		fi

	# 対象コンテナにおいて対象のネットワーク名のDNS名を取得, DNS名がなければAliasesを取得
	# $k: key: ネットワーク名, $v: value: ネットワーク設定
  done < <(
    docker inspect --format \
      '{{range $k,$v := .NetworkSettings.Networks}}{{$.Name}}{{"\t"}}{{$k}}{{"\t"}}{{if $v.DNSNames}}{{join $v.DNSNames ","}}{{else if $v.Aliases}}{{join $v.Aliases ","}}{{end}}{{"\n"}}{{end}}' \
      "${ref_containers[@]}"
  )
}

# ネットワーク情報取得
# 引数: 
# $1: ネットワーク名配列参照
# $2: ドライバー連想配列参照(key: network)
# $3: スコープ連想配列参照(key: network)
load_docker_network_ls() {
	local -n ref_network_names="$1"
	local -n ref_network_drivers="$2"
	local -n ref_network_scopes="$3"

	while IFS=$'\t' read -r net driver scope; do
		# 空行の場合はスキップ
		[[ -z "$net" ]] && continue

		# ネットワーク名配列に追加
		ref_network_names+=("$net")
		ref_network_drivers["$net"]="$driver"
		ref_network_scopes["$net"]="$scope"
  done < <(docker network ls --format '{{.Name}}{{"\t"}}{{.Driver}}{{"\t"}}{{.Scope}}')
}

# 表示順を決める
# 参加コンテナが無いネットワークを先、あるものを後にする
# 各群の相対順は docker network ls のまま残す
# $1: ネットワーク名配列参照(only read)
# $2: コンテナ連想配列参照(key: network, value: コンテナ名群(/t区切り))(only read)
# $3: 表示順を整理したネットワーク名配列参照
order_networks_empty_first() {
	local -n ref_network_names="$1"
	local -n ref_network_containers="$2"
	local -n ref_ordered="$3"

	# 空のネットワークと参加コンテナがあるネットワークに分別
	local -a empty=() occupied=()
	local name
	for name in "${ref_network_names[@]}"; do
		if [[ -z "${ref_network_containers[$name]:-}" ]]; then
			empty+=("$name")
		else
			occupied+=("$name")
		fi
	done

	# 合成
	ref_ordered=()
	if ((${#empty[@]} > 0)); then
		ref_ordered+=("${empty[@]}")
	fi
	if ((${#occupied[@]} > 0)); then
		ref_ordered+=("${occupied[@]}")
	fi
}

# 所属数と、そのうち Status が Up で始まる数を数える
# $1: ネットワーク名
# $2: コンテナ連想配列参照(key: network, value: コンテナ名群(/t区切り))(only read)
# $3: ステータス連想配列参照(key: container)(only read)
# $4: up参照
# $5: total参照
count_network_members() {
	local network_name="$1"
	local -n ref_network_containers="$2"
	local -n ref_container_status="$3"
	local -n ref_up="$4"
	local -n ref_total="$5"

	# そのネットワークに所属するコンテナ名群取得
	local members="${ref_network_containers[$network_name]:-}"
	ref_up=0
	ref_total=0

	# 所属コンテナが無い場合は終了
	[[ -z "$members" ]] && return 0

	local -a names=()
	IFS=$'\t' read -ra names <<< "$members"

	local name status
	ref_total=${#names[@]}
	for name in "${names[@]}"; do
		[[ -z "$name" ]] && continue
		status="${ref_container_status[$name]:-}"
		# Up で始まるステータスの場合は up に加算
		if [[ "$status" == Up* ]]; then
			ref_up=$((ref_up + 1))
		fi
	done
}

show_netmap() {
	# ----- 情報取得 -----
	# コンテナ情報, -a: array: インデックス配列
	local -a container_names=()
	# -A: associative array: 連想配列, key: container
	local -A container_ports=() container_status=()

	# network_containers: key: network, value: コンテナ名群(/t区切り)
	local -A network_containers=()

	# ネットワーク情報
	local -a network_names=()
	# key: ネットワーク名
	local -A network_drivers=() network_scopes=()

	# dns情報 key: network|container
	local -A container_dns=()

	# コンテナ情報取得
	load_docker_ps container_names container_ports container_status
	# コンテナ詳細情報取得
	load_docker_inspect container_names container_dns network_containers
	# ネットワーク情報取得
	load_docker_network_ls network_names network_drivers network_scopes
	# --------------------------------

	# ネットワークが無い場合は終了
	[[ ${#network_names[@]} -eq 0 ]] && return 0

	# ----- 表示用変数の最大幅を取得 -----
	local w_net_container=0 w_drv_port=0 w_scope_status=0
	local s
  for s in "${network_names[@]}";   do (( ${#s} > w_net_container )) && w_net_container=${#s};   done
  for s in "${container_names[@]}";  do (( ${#s} > w_net_container )) && w_net_container=${#s};   done	
  for s in "${network_drivers[@]}"; do (( ${#s} > w_drv_port   )) && w_drv_port=${#s};   done
  for s in "${container_ports[@]}";   do (( ${#s} > w_drv_port  )) && w_drv_port=${#s};  done
  for s in "${network_scopes[@]}";  do (( ${#s} > w_scope_status )) && w_scope_status=${#s};  done
  for s in "${container_status[@]}";  do (( ${#s} > w_scope_status )) && w_scope_status=${#s}; done
	# ---------------------------------

	# 整列
	local -a ordered_networks=()
	order_networks_empty_first network_names network_containers ordered_networks

	# ------------- 表示 ---------------
	# header
	printf '%-*s  %-*s  %-*s  %s\n' "$(( w_net_container + 2 ))" "NETWORK" "$w_drv_port" "DRIVER" "$w_scope_status" "SCOPE" "UP/TOTAL"
	printf '%-*s  %-*s  %-*s  %s\n\n' "$(( w_net_container + 2 ))" "CONTAINER" "$w_drv_port" "PORTS" "$w_scope_status" "STATUS" "DNS"
  
	for network in "${ordered_networks[@]}"; do
		# ネットワークの参加コンテナ数と Up の数を取得
		local up=0 total=0
		count_network_members "$network" network_containers container_status up total
		local summary=""
		(( $total > 0 )) && summary="${up}/${total} up"
		# ネットワーク表示
		printf '%-*s  %-*s  %-*s  %s\n' \
			"$(( w_net_container + 2 ))" "$network" \
			"$w_drv_port" "${network_drivers[$network]}" \
			"$w_scope_status" "${network_scopes[$network]}" \
			"$summary"

		# そのネットワークのコンテナ表示
		# -a: assign words to array: 分割した単語を配列に代入
		local has_container=0
		while IFS=$'\t' read -ra containers; do
			for container in "${containers[@]}"; do
				local branch="├"
				# 最後の要素の場合は└
				[[ "$container" == "${containers[-1]}" ]] && branch="└"

				# コンテナ表示
				printf '%s %-*s  %-*s  %-*s  %s\n' \
					"$branch" \
					"$w_net_container" "$container" \
					"$w_drv_port" "${container_ports[$container]:-"-"}" \
					"$w_scope_status" "${container_status[$container]:-}" \
					"${container_dns["${network}|${container}"]:-}"

				has_container=1
			done
		done  <<< "${network_containers[$network]:-}"
		# コンテナが無い場合は改行しない
		(( $has_container )) && printf '\n'

	done
}

show_netmap

